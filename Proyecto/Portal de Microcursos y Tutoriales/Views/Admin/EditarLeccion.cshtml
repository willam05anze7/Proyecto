@model Portal_de_Microcursos_y_Tutoriales.Models.Leccion

@{
    ViewData["Title"] = "Editar Lección";
    var curso = ViewBag.Curso as Portal_de_Microcursos_y_Tutoriales.Models.Curso;
}

<div class="container mt-4 pb-5">

    <div class="page-header">
        <h1>✏️ Editar Lección</h1>
        <p class="subtitle">
            Curso: <strong>@curso?.Titulo</strong>
        </p>
        <div class="accent-line"></div>
    </div>

    <div class="form-card">
        <form asp-action="EditarLeccion" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CursoId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-portal mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contenido" class="form-label"></label>
                <textarea asp-for="Contenido" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Contenido" class="text-danger small"></span>
            </div>

            <div class="mb-4" style="max-width:200px">
                <label asp-for="Orden" class="form-label"></label>
                <input asp-for="Orden" class="form-control" type="number" min="1" />
                <div class="text-muted small">Número que define la posición de la lección.</div>
                <span asp-validation-for="Orden" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-portal">Guardar cambios</button>
                <a asp-action="Lecciones" asp-route-id="@Model.CursoId"
                   class="btn btn-outline-secondary rounded-3">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
