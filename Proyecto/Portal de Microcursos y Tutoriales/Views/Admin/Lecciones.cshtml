@model Portal_de_Microcursos_y_Tutoriales.Models.Curso

@{
    ViewData["Title"] = $"Lecciones — {Model.Titulo}";
    var lecciones = Model.Lecciones?.OrderBy(l => l.Orden).ToList() ?? [];
}

<div class="container mt-4 pb-5">

    <!-- Encabezado -->
    <div class="page-header">
        <h1>📋 Lecciones del curso</h1>
        <p class="subtitle">@Model.Titulo</p>
        <div class="accent-line"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-portal alert-dismissible fade show" role="alert">
            ✅ @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@lecciones.Count lección(es) en total</span>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">← Volver</a>
            <a asp-action="CrearLeccion" asp-route-id="@Model.Id"
               class="btn-primary-portal">+ Nueva lección</a>
        </div>
    </div>

    @if (!lecciones.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📄</div>
            <h5>Este curso aún no tiene lecciones</h5>
            <p>Agrega la primera lección para empezar a estructurar el contenido.</p>
            <a asp-action="CrearLeccion" asp-route-id="@Model.Id" class="btn-primary-portal">
                + Agregar primera lección
            </a>
        </div>
    }
    else
    {
        <div class="lecciones-list">
            @for (int i = 0; i < lecciones.Count; i++)
            {
                var leccion = lecciones[i];
                <div class="leccion-item" style="justify-content:space-between; flex-wrap:wrap; gap:.75rem;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="leccion-num">@leccion.Orden</div>
                        <div>
                            <div class="fw-semibold" style="color:var(--text-dark)">@leccion.Titulo</div>
                            <div class="text-muted" style="font-size:.82rem">
                                @(leccion.Contenido.Length > 90
                                    ? leccion.Contenido[..90] + "…"
                                    : leccion.Contenido)
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1 align-items-center">

                        <!-- Subir -->
                        @if (i > 0)
                        {
                            <form asp-action="MoverLeccion" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@leccion.Id" />
                                <input type="hidden" name="direccion" value="subir" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Subir">▲</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>▲</button>
                        }

                        <!-- Bajar -->
                        @if (i < lecciones.Count - 1)
                        {
                            <form asp-action="MoverLeccion" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@leccion.Id" />
                                <input type="hidden" name="direccion" value="bajar" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Bajar">▼</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>▼</button>
                        }

                        <!-- Editar -->
                        <a asp-action="EditarLeccion" asp-route-id="@leccion.Id"
                           class="btn btn-sm btn-outline-dark" title="Editar">✏️</a>

                        <!-- Eliminar -->
                        <a asp-action="EliminarLeccion" asp-route-id="@leccion.Id"
                           class="btn btn-sm btn-outline-danger" title="Eliminar">🗑️</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
