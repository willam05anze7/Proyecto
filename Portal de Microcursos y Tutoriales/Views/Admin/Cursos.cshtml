@model IEnumerable<Portal_de_Microcursos_y_Tutoriales.Models.Curso>

@{
    ViewData["Title"] = "Gestión de Cursos";
}

<div class="page-header mt-4">
    <h1>📚 Gestión de Cursos</h1>
    <p class="subtitle">Administra el catálogo de cursos del portal</p>
    <div class="accent-line"></div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-portal alert-dismissible fade show mx-3" role="alert">
        ✅ @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container pb-5">
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="CrearCurso" class="btn-primary-portal">+ Nuevo Curso</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📚</div>
            <h4>No hay cursos aún</h4>
            <a asp-action="CrearCurso" class="btn-primary-portal mt-2">Crear el primer curso</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle" style="background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--card-shadow)">
                <thead style="background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff">
                    <tr>
                        <th class="ps-3">Título</th>
                        <th>Nivel</th>
                        <th>Duración</th>
                        <th class="text-center">Lecciones</th>
                        <th class="text-center">Inscritos</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var curso in Model)
                    {
                        var horas = curso.DuracionMinutos / 60;
                        var mins  = curso.DuracionMinutos % 60;
                        var dur   = horas > 0 ? $"{horas}h {(mins > 0 ? mins + "min" : "")}" : $"{mins}min";
                        <tr>
                            <td class="ps-3 fw-semibold">@curso.Titulo</td>
                            <td>
                                <span class="badge-nivel @(curso.Nivel.ToLower().Contains("básico") || curso.Nivel.ToLower().Contains("basico") ? "basico" : curso.Nivel.ToLower().Contains("intermedio") ? "intermedio" : curso.Nivel.ToLower().Contains("avanzado") ? "avanzado" : "default")">
                                    @curso.Nivel
                                </span>
                            </td>
                            <td class="text-muted">⏱ @dur</td>
                            <td class="text-center">
                                <a asp-action="Lecciones" asp-route-cursoId="@curso.Id"
                                   class="text-decoration-none fw-bold" style="color:var(--primary)">
                                    @curso.Lecciones.Count
                                </a>
                            </td>
                            <td class="text-center">
                                <a asp-action="Inscritos" asp-route-cursoId="@curso.Id"
                                   class="text-decoration-none fw-bold" style="color:var(--primary)">
                                    @curso.Inscripciones.Count
                                </a>
                            </td>
                            <td class="text-center">
                                <form asp-action="TogglePublicacion" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@curso.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                        class="badge border-0 @(curso.EstaPublicado ? "bg-success" : "bg-secondary")"
                                        style="cursor:pointer;padding:.4em .9em;font-size:.8rem">
                                        @(curso.EstaPublicado ? "✅ Publicado" : "⏸ Borrador")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Lecciones" asp-route-cursoId="@curso.Id"
                                       class="btn btn-sm btn-outline-primary" title="Lecciones">📋</a>
                                    <a asp-action="EditarCurso" asp-route-id="@curso.Id"
                                       class="btn btn-sm btn-outline-warning" title="Editar">✏️</a>
                                    <a asp-action="EliminarCurso" asp-route-id="@curso.Id"
                                       class="btn btn-sm btn-outline-danger" title="Eliminar">🗑️</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
