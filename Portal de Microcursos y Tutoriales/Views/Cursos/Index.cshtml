@model IEnumerable<Portal_de_Microcursos_y_Tutoriales.Models.Curso>

@{
    ViewData["Title"] = "Cursos disponibles";
}

<!-- Encabezado de la sección -->
<div class="page-header mt-4">
    <h1>Nuestros Cursos</h1>
    <p class="subtitle">Aprende a tu ritmo con nuestros microcursos y tutoriales</p>
    <div class="accent-line"></div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📚</div>
        <h4>Aún no hay cursos publicados</h4>
        <p>Vuelve pronto, estamos preparando contenido increíble para ti.</p>
    </div>
}
else
{
    <div class="container pb-5">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var curso in Model)
            {
                var nivelLower = curso.Nivel.ToLower();
                var badgeClass = nivelLower.Contains("básico") || nivelLower.Contains("basico") ? "basico"
                               : nivelLower.Contains("intermedio") ? "intermedio"
                               : nivelLower.Contains("avanzado") ? "avanzado"
                               : "default";
                var horas = curso.DuracionMinutos / 60;
                var minutos = curso.DuracionMinutos % 60;
                var duracionTexto = horas > 0
                    ? (minutos > 0 ? $"{horas}h {minutos}min" : $"{horas}h")
                    : $"{minutos} min";

                <div class="col">
                    <div class="curso-card card">
                        <div class="card-header-gradient"></div>
                        <div class="card-body">
                            <span class="badge-nivel @badgeClass mb-2 d-inline-block">
                                @curso.Nivel
                            </span>
                            <h5 class="card-title">@curso.Titulo</h5>
                            <p class="card-text">@curso.Descripcion</p>
                        </div>
                        <div class="card-footer-custom">
                            <span class="duracion-chip">
                                ⏱ @duracionTexto
                            </span>
                            <a asp-action="Details" asp-route-id="@curso.Id"
                               class="btn-primary-portal">
                                Ver curso →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
